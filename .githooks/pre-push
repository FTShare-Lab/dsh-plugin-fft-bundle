#!/bin/sh
# Push-time guard for the composition bundle's dependency anchors.
#
# The edges no longer follow a per-branch ref: unpublished packages carry the
# previous release's tag (and this release's own tag on the release commit),
# published packages carry exact registry versions, and kline carries its own
# release tag. Running the check on every push keeps a hand-edited manifest from
# landing — there is no `#dev` to flip back to any more.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass in an emergency:  git push --no-verify
exec node scripts/edge-refs.mjs check

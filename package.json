{
  "name": "@dsh-ft/finance-all-in-one",
  "version": "1.2.0",
  "description": "Composition bundle for the FT financial workbench: installs and wires the dsh-fft plugin set with shared defaults.",
  "license": "MIT",
  "author": "Ben <ben@ft.tech>",
  "homepage": "https://github.com/FTShare-Lab/dsh-plugin-fft-bundle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FTShare-Lab/dsh-plugin-fft-bundle.git"
  },
  "bugs": {
    "url": "https://github.com/FTShare-Lab/dsh-plugin-fft-bundle/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "finance",
    "stock",
    "a-share",
    "research",
    "paper-trading",
    "kline"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "./icon.png",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.png",
    "LICENSE",
    "README.md",
    "locale/*.json",
    "lib/index.js",
    "lib/index.d.ts",
    "lib/status.js",
    "lib/status.d.ts",
    "lib/manifest.js",
    "lib/manifest.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "scripts/kline-mcp.mjs"
  ],
  "scripts": {
    "build": "pnpm run build:bundle && pnpm -r run build",
    "build:bundle": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-manifest.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs && pnpm -r run test && node scripts/ui-audit.mjs",
    "typecheck": "pnpm -r run typecheck",
    "ui:audit": "node scripts/ui-audit.mjs",
    "pack:tarball": "node scripts/pack-tarball.mjs",
    "pack:npm": "node scripts/pack-npm.mjs",
    "upload:asset": "node scripts/upload-release-asset.mjs",
    "upload:npm": "node scripts/upload.mjs --npm"
  },
  "dependencies": {
    "@dsh-ft/dsh-fft-settings": ">=0.7.3",
    "@dsh-ft/dsh-fft-ftshare": ">=0.4.4",
    "@dsh-ft/dsh-fft-gallery": ">=0.1.3",
    "@dsh-ft/dsh-fft-plot": ">=0.2.0",
    "@dsh-ft/dsh-fft-paper-trading": ">=0.8.1",
    "@ftshare-lab/dsh-kline": ">=0.6.11"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  },
  "devDependencies": {
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.22.0"
}

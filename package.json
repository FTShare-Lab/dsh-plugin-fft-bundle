{
  "name": "dsh-fft-bundle-repo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test && node scripts/ui-audit.mjs",
    "typecheck": "pnpm -r run typecheck",
    "ui:audit": "node scripts/ui-audit.mjs",
    "pack:tarball": "node scripts/pack-tarball.mjs",
    "pack:npm": "node scripts/pack-npm.mjs",
    "upload:asset": "node scripts/upload-release-asset.mjs",
    "upload:npm": "node scripts/upload.mjs --npm"
  },
  "packageManager": "pnpm@11.22.0"
}

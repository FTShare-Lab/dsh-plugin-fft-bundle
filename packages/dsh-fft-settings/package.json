{
  "name": "@ft/dsh-fft-settings",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "docs",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract": {
      "types": "./lib/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./client-api": {
      "types": "./lib/rpc.d.ts",
      "default": "./lib/rpc.js"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.8.3",
    "react": "^18.3.1",
    "@types/react": "^18.3.24",
    "@types/node": "^22.15.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

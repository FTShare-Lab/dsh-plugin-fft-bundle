{
  "name": "@ft/dsh-fft-research-cockpit",
  "version": "0.2.1",
  "description": "FT 投研舱：FTShare-only investment research tools for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node scripts/test-indicators.mjs && node scripts/test-report-facts.mjs && node scripts/test-missing-data.mjs && node scripts/test-report-completeness.mjs && node scripts/test-llm-contracts.mjs && node scripts/test-fft-sidebar.mjs && node scripts/test-report-host-sidebar.mjs && node scripts/test-report-export-bridge.mjs && node scripts/test-sector-structure.mjs",
    "test:ftshare": "pnpm run build && node scripts/test-ftshare.mjs",
    "test:permissions:browser": "pnpm run build && node scripts/test-permission-rendering.mjs",
    "test:market-commentary": "pnpm run build && node scripts/test-market-commentary.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@ft/dsh-fft-settings": "git+ssh://git@github.com/FTShare-Lab/dsh-plugin-fft-bundle.git#path:packages/dsh-fft-settings",
    "@deepseek-ai/schemastery": ">=3.18.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "nunjucks": "3.2.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "dsh-better-sidebar": ">=0.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nunjucks": "3.2.6",
    "typescript": "^5.8.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "dsh-better-sidebar"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

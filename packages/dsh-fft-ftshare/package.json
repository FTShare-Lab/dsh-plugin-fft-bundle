{
  "name": "@dsh-ft/dsh-fft-ftshare",
  "version": "0.2.1",
  "description": "FTShare 数据底座：全 bundle 唯一出站、一处四态归一、一处模型可见面，并随包发布上游接口目录。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract": {
      "types": "./lib/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./catalog": {
      "types": "./lib/catalog.d.ts",
      "default": "./lib/catalog.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./mask": {
      "types": "./lib/mask.d.ts",
      "default": "./lib/mask.js"
    },
    "./project": {
      "types": "./lib/project.d.ts",
      "default": "./lib/project.js"
    },
    "./route": {
      "types": "./lib/route.d.ts",
      "default": "./lib/route.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./catalog.json": "./catalog.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "catalog.json",
    "catalog.txt",
    "catalog.meta.json",
    "README.md",
    "cordis.patch.yml",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "catalog": "pnpm run build && node scripts/build-catalog.mjs",
    "catalog:check": "pnpm run build && node scripts/build-catalog.mjs --check",
    "test": "pnpm run build && node scripts/test-projection.mjs && node scripts/test-service.mjs && node scripts/test-catalog.mjs && node scripts/test-mask.mjs && node scripts/test-crossplane.mjs"
  },
  "dependencies": {
    "@dsh-ft/dsh-fft-settings": "git+ssh://git@github.com/FTShare-Lab/dsh-plugin-fft-bundle.git#path:packages/dsh-fft-settings",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  }
}

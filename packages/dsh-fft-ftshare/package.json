{
  "name": "@dsh-ft/dsh-fft-ftshare",
  "version": "0.3.0",
  "description": "FTShare 数据底座：全 bundle 唯一出站、一处四态归一、一处模型可见面，并随包发布上游接口目录。",
  "license": "MIT",
  "homepage": "https://github.com/gigaflw/dsh-fft-bundle/tree/dev/packages/dsh-fft-ftshare#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gigaflw/dsh-fft-bundle.git",
    "directory": "packages/dsh-fft-ftshare"
  },
  "bugs": {
    "url": "https://github.com/gigaflw/dsh-fft-bundle/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ftshare",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract": {
      "types": "./lib/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./catalog": {
      "types": "./lib/catalog.d.ts",
      "default": "./lib/catalog.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./mask": {
      "types": "./lib/mask.d.ts",
      "default": "./lib/mask.js"
    },
    "./project": {
      "types": "./lib/project.d.ts",
      "default": "./lib/project.js"
    },
    "./route": {
      "types": "./lib/route.d.ts",
      "default": "./lib/route.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./catalog.json": "./catalog.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "catalog.json",
    "catalog.txt",
    "catalog.meta.json",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "locale/*.json",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "catalog": "pnpm run build && node scripts/build-catalog.mjs",
    "catalog:check": "pnpm run build && node scripts/build-catalog.mjs --check",
    "test": "pnpm run build && node scripts/test-upstream.mjs && node scripts/test-projection.mjs && node scripts/test-service.mjs && node scripts/test-catalog.mjs && node scripts/test-mask.mjs && node scripts/test-crossplane.mjs"
  },
  "dependencies": {
    "@dsh-ft/dsh-fft-settings": "0.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  }
}

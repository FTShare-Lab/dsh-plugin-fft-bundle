{
  "name": "@dsh-ft/finance-all-in-one",
  "version": "1.0.2",
  "description": "Composition bundle for the FT financial workbench: installs and wires the dsh-fft plugin set with shared defaults.",
  "license": "MIT",
  "author": "Ben <ben@ft.tech>",
  "homepage": "https://github.com/FTShare-Lab/dsh-plugin-fft-bundle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FTShare-Lab/dsh-plugin-fft-bundle.git",
    "directory": "packages/dsh-fft-bundle"
  },
  "bugs": {
    "url": "https://github.com/FTShare-Lab/dsh-plugin-fft-bundle/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "finance",
    "stock",
    "a-share",
    "research",
    "paper-trading",
    "kline"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "./icon.png",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.png",
    "LICENSE",
    "README.md",
    "locale/*.json",
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "scripts/kline-mcp.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@dsh-ft/dsh-fft-settings": ">=0.7.1",
    "@dsh-ft/dsh-fft-ftshare": ">=0.4.2",
    "@dsh-ft/dsh-fft-plot": ">=0.1.0",
    "@dsh-ft/dsh-fft-paper-trading": ">=0.7.2",
    "@ftshare-lab/dsh-kline": ">=0.6.11"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  },
  "devDependencies": {
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.3"
  }
}

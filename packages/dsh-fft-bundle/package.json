{
  "name": "@ft/dsh-fft-bundle",
  "version": "0.9.3",
  "description": "Composition bundle for the FT financial workbench: installs and wires the dsh-fft plugin set with shared defaults.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "./icon.png",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.png",
    "locale/*.json",
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "scripts/kline-mcp.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@dsh-ft/dsh-fft-settings": "0.5.1",
    "@dsh-ft/dsh-fft-ftshare": "0.4.0",
    "@dsh-ft/dsh-fft-paper-trading": "0.6.3",
    "@ftshare-lab/dsh-kline": "git+ssh://git@github.com/gigaflw/dsh_kline.git#v0.6.7-ft.1",
    "@dsh-ft/dsh-fft-plot": "0.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  },
  "devDependencies": {
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.3"
  }
}
